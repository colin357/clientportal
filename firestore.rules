rules_version = '2';

// ============================================================================
// FIRESTORE SECURITY RULES FOR CLIENT PORTAL - SOC2 COMPLIANT
// ============================================================================
//
// CURRENT MODE: PRODUCTION MODE (SOC2 Compliant)
// ✅ Secure rules with proper access controls
// ✅ Audit logging protection
// ✅ Role-based access control
//
// To apply these rules:
// 1. Go to Firebase Console → Firestore Database → Rules tab
// 2. Copy and paste these rules
// 3. Click "Publish"
//
// IMPORTANT: This assumes Firebase Authentication is enabled
// If using JWT-only auth, access should go through API endpoints only
// ============================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Audit Logs - CRITICAL FOR SOC2 COMPLIANCE
    // Write-only, immutable audit trail
    match /auditLogs/{logId} {
      // Only allow creation, no reads or updates to maintain immutability
      // Reads should be done through admin API with proper authentication
      allow create: if true; // Allow audit log creation from anywhere
      allow read: if false;  // No direct reads - use authenticated API
      allow update, delete: if false; // Immutable - cannot be modified or deleted
    }

    // Users collection
    match /users/{userId} {
      // Anyone can create an account (signup)
      allow create: if true;

      // Users can read their own data, admins can read all
      allow read: if isSignedIn() && (isOwner(userId) || isAdmin());

      // Users can update their own data, admins can update all
      // Prevent password field from being read directly
      allow update: if isSignedIn() && (isOwner(userId) || isAdmin());

      // Only admins can delete users
      allow delete: if isAdmin();
    }

    // Content collection
    match /content/{contentId} {
      // Authenticated users can create content
      allow create: if isSignedIn();

      // Users can read their own content, admins can read all
      allow read: if isSignedIn() &&
                     (resource.data.clientId == request.auth.uid || isAdmin());

      // Users can update their own content, admins can update all
      allow update: if isSignedIn() &&
                       (resource.data.clientId == request.auth.uid || isAdmin());

      // Only admins can delete content
      allow delete: if isAdmin();
    }

    // Videos collection
    match /videos/{videoId} {
      // Authenticated users can create videos
      allow create: if isSignedIn();

      // Users can read their own videos, admins can read all
      allow read: if isSignedIn() &&
                     (resource.data.clientId == request.auth.uid || isAdmin());

      // Users can update their own videos, admins can update all
      allow update: if isSignedIn() &&
                       (resource.data.clientId == request.auth.uid || isAdmin());

      // Only admins can delete videos
      allow delete: if isAdmin();
    }

    // Calendar Events collection
    match /calendarEvents/{eventId} {
      // Authenticated users can create events
      allow create: if isSignedIn();

      // Users can read their own events, admins can read all
      allow read: if isSignedIn() &&
                     (resource.data.clientId == request.auth.uid || isAdmin());

      // Users can update their own events, admins can update all
      allow update: if isSignedIn() &&
                       (resource.data.clientId == request.auth.uid || isAdmin());

      // Only admins can delete events
      allow delete: if isAdmin();
    }

    // Groups collection
    match /groups/{groupId} {
      // Only admins can create groups
      allow create: if isAdmin();

      // All authenticated users can read groups they belong to
      allow read: if isSignedIn();

      // Only admins can update groups
      allow update: if isAdmin();

      // Only admins can delete groups
      allow delete: if isAdmin();
    }

    // Deny all other collections by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

